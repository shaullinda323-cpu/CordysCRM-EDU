<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.cordys.crm.education.mapper.ExtEducationGuardianMapper">
    <!-- Serialize links even before a guardian row exists. The service transaction holds this lock. -->
    <select id="lockStudent" resultType="java.lang.String">
        SELECT id FROM edu_student
        WHERE id = #{studentId} AND organization_id = #{orgId}
        FOR UPDATE
    </select>
    <!-- A current read is necessary after waiting: an earlier permission read may have created an RR snapshot. -->
    <select id="selectLinkForUpdate" resultType="cn.cordys.crm.education.domain.EducationGuardian">
        SELECT * FROM edu_guardian
        WHERE student_id = #{studentId} AND contact_id = #{contactId} AND organization_id = #{orgId}
        FOR UPDATE
    </select>
</mapper>
